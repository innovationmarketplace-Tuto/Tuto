# Client-side (safe to expose; read by the Expo app). Replace this only with
# the URL for the intended Convex deployment; it is not a secret.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex Auth's site URL is deployment-scoped and safe to expose to the
# client only via the Expo public variable below. Set the matching site-domain
# value in Convex deployment env for auth.config.ts.
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Everything below is set per Convex deployment with `npx convex env set`,
# --- never read from a local .env file by the app. Listed here as names only
# --- so contributors know what exists. See AWS_PLAN.md "Convex configuration".
# --- Never put a real secret in this file.

# Convex Auth (generate per deployment; never commit values)
CONVEX_SITE_URL=https://your-deployment.convex.site
JWT_PRIVATE_KEY=
JWKS=

# AI tutor provider (fake | bedrock | openai)
TUTOR_MODEL_PROVIDER=fake
# Used when TUTOR_MODEL_PROVIDER=bedrock
TUTOR_MODEL_ID=
# Used when TUTOR_MODEL_PROVIDER=openai
# OPENAI_MODEL defaults to gpt-5.6-luna; OPENAI_REASONING_EFFORT defaults to
# "low" (minimal | low | medium | high).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=

# Document analysis provider
DOCUMENT_ANALYSIS_PROVIDER=fake
DOCUMENT_ANALYSIS_KILL_SWITCH=false

# AWS (only required when DOCUMENT_ANALYSIS_PROVIDER=aws_bda; see AWS_PLAN.md)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_WEB_IDENTITY_TOKEN_FILE=
AWS_ROLE_ARN=
AWS_BDA_MODE=sync
AWS_BDA_PROJECT_ARN=
AWS_BDA_PROJECT_STAGE=LIVE
AWS_BDA_PROFILE_ARN=
NOVA_MODEL_ID=
